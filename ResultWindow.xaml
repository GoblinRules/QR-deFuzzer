<Window x:Class="QR_deFuzzer.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR deFuzzer - Result" 
        Height="420" Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        MouseDown="Window_MouseDown"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Modern ScrollViewer Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#44FFFFFF" BorderBrush="Transparent" BorderThickness="0" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#FF7000FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#FF8822FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#FF5500CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Button Style -->
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFA090FF"/>
            <Setter Property="BorderBrush" Value="#44A090FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#15A090FF"/>
                                <Setter Property="Foreground" Value="#FFC0B0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#30A090FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- IconButton Style (mini copy buttons) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#15FFFFFF"/>
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#45FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer drop shadow border -->
    <Border Background="#121216" BorderBrush="#252530" BorderThickness="1.5" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6" />
        </Border.Effect>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Area -->
                <RowDefinition Height="Auto"/> <!-- Settings/Footer -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Image Name="AppIconImage" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" Source="assets/icon.png" />
                <TextBlock Grid.Column="1" Text="QR Decoded!" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                
                <Button Grid.Column="2" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#88FFFFFF" BorderThickness="0" FontSize="14" Cursor="Hand" Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Name="Bg" Background="Transparent" CornerRadius="12">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Content Area (Switchable) -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <!-- PANEL A: Standard QR Code (Plain Text / URL) -->
                <Grid Name="StandardTextPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#1C1C24" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox Name="DecodedTextBox" 
                                     Background="Transparent" 
                                     Foreground="#E0E0E0" 
                                     BorderThickness="0" 
                                     TextWrapping="Wrap" 
                                     IsReadOnly="True" 
                                     IsReadOnlyCaretVisible="True"
                                     FontSize="13.5"
                                     SelectionBrush="#7F7000FF"/>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- URL Actions -->
                    <StackPanel Grid.Row="1" Name="UrlActionsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Content="Open in Browser ↗" Style="{StaticResource OutlineButton}" Click="OpenLinkButton_Click" Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>

                <!-- PANEL B: 2FA otpauth QR Code -->
                <Grid Name="TwoFactorPanel" Visibility="Collapsed">
                    <Border Background="#1C1C24" BorderBrush="#2C2C38" BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Issuer -->
                                <RowDefinition Height="Auto"/> <!-- Account -->
                                <RowDefinition Height="Auto"/> <!-- Secret -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Issuer -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Issuer:" Foreground="#88FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Name="IssuerTextBlock" Text="Proton" Foreground="White" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" ToolTip="Copy Issuer" Style="{StaticResource IconButton}" Click="CopyIssuer_Click">
                                    <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                            
                            <!-- Account -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Account:" Foreground="#88FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Name="AccountTextBlock" Text="john.doe@proton.me" Foreground="White" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" ToolTip="Copy Account" Style="{StaticResource IconButton}" Click="CopyAccount_Click">
                                    <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                            
                            <!-- Secret Key -->
                            <Grid Grid.Row="2" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Secret Key:" Foreground="#88FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Name="SecretTextBox" Text="JBSWY3DPEHPK3PXP" Foreground="#00E5FF" Background="Transparent" BorderThickness="0" IsReadOnly="True" FontSize="13.5" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Name="ToggleRevealButton" ToolTip="Reveal/Hide Secret" Style="{StaticResource IconButton}" Click="ToggleReveal_Click" Margin="0,0,4,0">
                                    <TextBlock Name="RevealEyeText" Text="👁️" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Grid.Column="3" ToolTip="Copy Secret Key" Style="{StaticResource IconButton}" Click="CopySecret_Click">
                                    <TextBlock Text="📋" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                            </Grid>
                            
                            <!-- Extra info and copy URI -->
                            <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="2FA Authenticator Setup Code detected." Foreground="#FF888899" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Copy Full URI" Style="{StaticResource OutlineButton}" Click="CopyFullUri_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Settings / Auto-copy option -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <CheckBox Name="AutoCopyCheckBox" 
                          Content="Auto-copy decoded text to clipboard" 
                          Foreground="#FFAAAAAA" 
                          FontSize="12"
                          Checked="AutoCopyCheckBox_Changed"
                          Unchecked="AutoCopyCheckBox_Changed">
                    <CheckBox.Resources>
                        <!-- Customize CheckBox check mark coloring to fit neon theme -->
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </CheckBox.Resources>
                </CheckBox>
            </Grid>

            <!-- Bottom Buttons Row -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Name="ToastNotificationText" Text="" Foreground="#FF00FF88" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="CopyButton" Content="Copy Text" Style="{StaticResource AccentButton}" Click="CopyButton_Click" Margin="0,0,8,0" />
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Click="CloseButton_Click" IsCancel="True" Padding="18,6" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
