<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="QR-deFuzzer"
    Manufacturer="Ghost Kernel"
    Version="1.1.9.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of QR-deFuzzer is already installed." />

    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ghostkernel.cc" />

    <!-- Application Files -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="QR-deFuzzer">
        <Component Id="MainExecutable" Guid="2F92D39A-2EF4-4B5F-92E5-5A53E7D987F9">
          <File Id="QRdeFuzzerExe"
                Source="$(PublishDir)\QR-deFuzzer.exe"
                KeyPath="yes" />
        </Component>
        <Component Id="AppPathsRegistration" Guid="9A3B5D99-31F0-463C-8D73-6E173539D067">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Type="string"
                         Value="[INSTALLFOLDER]QR-deFuzzer.exe"
                         KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Name="Path"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
        </Component>
        <Component Id="InstalledAppsRegistration" Guid="4471794D-44B0-4CC9-9E9D-A336E8F9D0A8">
          <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\QR-deFuzzer">
            <RegistryValue Name="DisplayName" Type="string" Value="QR-deFuzzer" />
            <RegistryValue Name="DisplayVersion" Type="string" Value="1.1.9" />
            <RegistryValue Name="Publisher" Type="string" Value="Ghost Kernel" />
            <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
            <RegistryValue Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]QR-deFuzzer.exe" />
            <RegistryValue Name="UninstallString" Type="string" Value="MsiExec.exe /x [ProductCode]" />
            <RegistryValue Name="QuietUninstallString" Type="string" Value="MsiExec.exe /x [ProductCode] /qn" />
            <RegistryValue Name="NoModify" Type="integer" Value="1" />
            <RegistryValue Name="NoRepair" Type="integer" Value="1" />
            <RegistryValue Name="EstimatedSize" Type="integer" Value="183000" KeyPath="yes" />
          </RegistryKey>
        </Component>
        <Component Id="StartupRegistration" Guid="D3296053-8F13-49D1-92F0-40E50FA480F8" Condition="STARTUP=1">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="QR-deFuzzer"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]QR-deFuzzer.exe&quot;"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0674D6C4-1402-4CEE-860D-D7C7F6D58532">
        <Shortcut Id="DesktopShortcutLink"
                  Name="QR-deFuzzer"
                  Description="QR Code Scanner &amp; Decoder"
                  Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\QR-deFuzzer\Install" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="QR-deFuzzer">
        <Component Id="StartMenuShortcut" Guid="039AB9A6-E672-46C4-9F1C-D1B870706671">
          <Shortcut Id="StartMenuShortcutLink"
                    Name="QR-deFuzzer"
                    Description="QR Code Scanner &amp; Decoder"
                    Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RegistryValue Root="HKLM" Key="Software\QR-deFuzzer\Install" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Icon definition for shortcuts -->
    <Icon Id="AppIcon" SourceFile="$(ProjectDir)\assets\icon.ico" />

    <!-- Feature -->
    <Feature Id="Complete" Title="QR-deFuzzer" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppPathsRegistration" />
      <ComponentRef Id="InstalledAppsRegistration" />
      <ComponentRef Id="StartupRegistration" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
