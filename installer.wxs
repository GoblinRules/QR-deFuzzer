<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="QR-deFuzzer"
    Manufacturer="Ghost Kernel"
    Version="1.1.2.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perUser"
    Compressed="yes">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of QR-deFuzzer is already installed." />

    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ghostkernel.cc" />

    <!-- Application Files -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="QR-deFuzzer">
        <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
          <File Id="QRdeFuzzerExe"
                Source="$(PublishDir)\QR-deFuzzer.exe"
                KeyPath="yes" />
        </Component>
        <Component Id="AppPathsRegistration" Guid="E1F2A3B4-C5D6-7890-EFAB-345678901234">
          <RegistryValue Root="HKCU"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Type="string"
                         Value="[INSTALLFOLDER]QR-deFuzzer.exe"
                         KeyPath="yes" />
          <RegistryValue Root="HKCU"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Name="Path"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
        </Component>
        <Component Id="InstalledAppsRegistration" Guid="F1A2B3C4-D5E6-7890-FABC-456789012345">
          <RegistryKey Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\QR-deFuzzer">
            <RegistryValue Name="DisplayName" Type="string" Value="QR-deFuzzer" />
            <RegistryValue Name="DisplayVersion" Type="string" Value="1.1.2" />
            <RegistryValue Name="Publisher" Type="string" Value="Ghost Kernel" />
            <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
            <RegistryValue Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]QR-deFuzzer.exe" />
            <RegistryValue Name="UninstallString" Type="string" Value="MsiExec.exe /x [ProductCode]" />
            <RegistryValue Name="QuietUninstallString" Type="string" Value="MsiExec.exe /x [ProductCode] /qn" />
            <RegistryValue Name="NoModify" Type="integer" Value="1" />
            <RegistryValue Name="NoRepair" Type="integer" Value="1" />
            <RegistryValue Name="EstimatedSize" Type="integer" Value="183000" KeyPath="yes" />
          </RegistryKey>
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C1D2E3F4-A5B6-7890-CDEF-123456789012">
        <Shortcut Id="DesktopShortcutLink"
                  Name="QR-deFuzzer"
                  Description="QR Code Scanner &amp; Decoder"
                  Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\QR-deFuzzer\Install" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="QR-deFuzzer">
        <Component Id="StartMenuShortcut" Guid="D1E2F3A4-B5C6-7890-DEFA-234567890123">
          <Shortcut Id="StartMenuShortcutLink"
                    Name="QR-deFuzzer"
                    Description="QR Code Scanner &amp; Decoder"
                    Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RegistryValue Root="HKCU" Key="Software\QR-deFuzzer\Install" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Icon definition for shortcuts -->
    <Icon Id="AppIcon" SourceFile="$(ProjectDir)\assets\icon.ico" />

    <!-- Feature -->
    <Feature Id="Complete" Title="QR-deFuzzer" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppPathsRegistration" />
      <ComponentRef Id="InstalledAppsRegistration" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>
</Wix>
