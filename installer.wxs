<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="QR-deFuzzer"
    Manufacturer="Ghost Kernel"
    Version="1.1.11.0"
    UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
    Scope="perMachine"
    Compressed="yes">

    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of QR-deFuzzer is already installed." />

    <MediaTemplate EmbedCab="yes" />
    <util:CloseApplication Id="CloseRunningQrDeFuzzer"
                           Target="QR-deFuzzer.exe"
                           Description="QR-deFuzzer"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://ghostkernel.cc" />
    <Property Id="STARTUP" Secure="yes" />
    <Property Id="AUTOCOPY" Secure="yes" />
    <CustomAction Id="LaunchQRdeFuzzer"
                  FileRef="QRdeFuzzerExe"
                  ExeCommand=""
                  Return="asyncNoWait"
                  Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="LaunchQRdeFuzzer" After="InstallFinalize" Condition="NOT Installed AND UILevel &gt;= 3" />
    </InstallExecuteSequence>

    <!-- Application Files -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="QR-deFuzzer">
        <Component Id="MainExecutable" Guid="2F92D39A-2EF4-4B5F-92E5-5A53E7D987F9">
          <File Id="QRdeFuzzerExe"
                Source="$(PublishDir)\QR-deFuzzer.exe"
                KeyPath="yes" />
        </Component>
        <Component Id="AppPathsRegistration" Guid="9A3B5D99-31F0-463C-8D73-6E173539D067">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Type="string"
                         Value="[INSTALLFOLDER]QR-deFuzzer.exe"
                         KeyPath="yes" />
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\App Paths\QR-deFuzzer.exe"
                         Name="Path"
                         Type="string"
                         Value="[INSTALLFOLDER]" />
        </Component>
        <Component Id="StartupRegistration" Guid="D3296053-8F13-49D1-92F0-40E50FA480F8" Condition="STARTUP=1">
          <RegistryValue Root="HKLM"
                         Key="Software\Microsoft\Windows\CurrentVersion\Run"
                         Name="QR-deFuzzer"
                         Type="string"
                         Value="&quot;[INSTALLFOLDER]QR-deFuzzer.exe&quot;"
                         KeyPath="yes" />
        </Component>
        <Component Id="AutoCopyDefault" Guid="7CB909D2-4493-4E20-958C-17B4B4382440" Condition="AUTOCOPY=1">
          <RegistryValue Root="HKLM"
                         Key="Software\QR-deFuzzer\Defaults"
                         Name="AutoCopy"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop Shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0674D6C4-1402-4CEE-860D-D7C7F6D58532">
        <Shortcut Id="DesktopShortcutLink"
                  Name="QR-deFuzzer"
                  Description="QR Code Scanner &amp; Decoder"
                  Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKLM" Key="Software\QR-deFuzzer\Install" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Start Menu Shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="QR-deFuzzer">
        <Component Id="StartMenuShortcut" Guid="039AB9A6-E672-46C4-9F1C-D1B870706671">
          <Shortcut Id="StartMenuShortcutLink"
                    Name="QR-deFuzzer"
                    Description="QR Code Scanner &amp; Decoder"
                    Target="[INSTALLFOLDER]QR-deFuzzer.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RegistryValue Root="HKLM" Key="Software\QR-deFuzzer\Install" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Icon definition for shortcuts -->
    <Icon Id="AppIcon" SourceFile="$(ProjectDir)\assets\icon.ico" />

    <!-- Feature -->
    <Feature Id="Complete" Title="QR-deFuzzer" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="AppPathsRegistration" />
      <ComponentRef Id="StartupRegistration" />
      <ComponentRef Id="AutoCopyDefault" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Dialog Id="OptionsDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\\WixUI_Font_Title}Setup Options" />
        <Control Id="Description" Type="Text" X="20" Y="23" Width="330" Height="30" Transparent="yes" NoPrefix="yes" Text="Choose optional settings to apply during installation." />
        <Control Id="StartupCheckbox" Type="CheckBox" X="20" Y="80" Width="310" Height="18" Property="STARTUP" CheckBoxValue="1" Text="Run QR-deFuzzer when Windows starts" />
        <Control Id="AutoCopyCheckbox" Type="CheckBox" X="20" Y="105" Width="310" Height="18" Property="AUTOCOPY" CheckBoxValue="1" Text="Auto-copy decoded QR text to clipboard by default" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel" />
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="OptionsDlg" Condition="1" />
      <Publish Dialog="OptionsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="1" />
      <Publish Dialog="OptionsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
      <Publish Dialog="OptionsDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg" Condition="1" />
    </UI>

  </Package>
</Wix>
