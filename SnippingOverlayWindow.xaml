<Window x:Class="QR_deFuzzer.SnippingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR deFuzzer - Snipping Tool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp">
    <Canvas Name="SelectionCanvas">
        <!-- Background screenshot image -->
        <Image Name="BackgroundImage" Stretch="Fill" />
        
        <!-- Dark overlay path with EvenOdd rule for cutout -->
        <Path Name="OverlayPath" Fill="#7F000000" />
        
        <!-- Selection border (Neon Purple/Blue) -->
        <Rectangle Name="SelectionBorder" 
                   Stroke="#A080FFFF" 
                   StrokeThickness="2" 
                   Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF00D0FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
            </Rectangle.Effect>
        </Rectangle>
        
        <!-- Tooltip instructions -->
        <Border Name="InfoTooltip" 
                Background="#E6101015" 
                CornerRadius="6" 
                Padding="12,8" 
                BorderBrush="#25FFFFFF" 
                BorderThickness="1" 
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#FFB0A0FF" FontWeight="Bold" FontSize="11" Text="QR-deFuzzer" Margin="0,0,8,0" />
                <TextBlock Foreground="#FFDDDDDD" FontSize="11" Text="•  Drag to select QR Code  •  Right-click or Esc to cancel" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
